<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Autorisations du « hardened runtime » exigé par la notarisation Apple.
  Electron (moteur JavaScript V8) a besoin de générer du code à l'exécution.
  Java et Minecraft tournent dans des processus séparés et ne sont pas concernés.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
